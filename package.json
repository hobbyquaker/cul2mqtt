{
  "name": "cul2mqtt",
  "version": "1.0.0",
  "description": "Interface between Busware CUL (FS20, EM, HMS, S300TH, FHT, MAX!, ...) and MQTT, with Home Assistant discovery",
  "type": "module",
  "main": "index.js",
  "preferGlobal": true,
  "bin": {
    "cul2mqtt": "index.js"
  },
  "files": [
    "index.js",
    "config.js",
    "lib/",
    "example-map.json"
  ],
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "scripts": {
    "start": "node index.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "deploy": "bash deploy.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/cul2mqtt.git"
  },
  "keywords": [
    "mqtt",
    "smarthome",
    "mqtt-smarthome",
    "home-automation",
    "home-assistant",
    "CUL",
    "Busware",
    "culfw",
    "FS20",
    "EM1000",
    "HMS",
    "S300TH",
    "FHT",
    "MAX",
    "868"
  ],
  "author": "Sebastian Raff <hobbyquaker@gmail.com> (https://hobbyquaker.github.io)",
  "license": "GPL-2.0",
  "bugs": {
    "url": "https://github.com/hobbyquaker/cul2mqtt/issues"
  },
  "homepage": "https://github.com/hobbyquaker/cul2mqtt",
  "dependencies": {
    "cul": "^1.0.0",
    "mqtt-interfaces-core": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  }
}
